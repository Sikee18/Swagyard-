# Swagyard Retail POS & Inventory Environment Configuration
# Copy this file to .env and supply your credentials

# PostgreSQL connection string for Supabase (Pooler: port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection string for migrations (Session: port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth Session Secret (at least 32 characters)
JWT_SECRET="swagyard-super-secure-production-jwt-session-secret-key-2026-xyz"

# Default Admin Seed Credentials (used during initial db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_secure_password_123"

# Brand & Store Identity
NEXT_PUBLIC_APP_NAME="Swagyard"
NEXT_PUBLIC_STORE_ADDRESS="174, Brazzer Street, Opp. Apollo Medical, Ammoor, Ranipet - 632501"
NEXT_PUBLIC_STORE_PHONE="+91 63853 68479"
NEXT_PUBLIC_STORE_EMAIL="swagyard.retail@gmail.com"
NEXT_PUBLIC_STORE_INSTA="swagyard.retail"
